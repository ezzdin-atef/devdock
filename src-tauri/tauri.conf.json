{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDock",
  "identifier": "dev.devdock.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDock",
        "width": 1280,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#121315"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "DevDock",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Desktop control panel for local dev projects",
    "longDescription": "DevDock finds your local projects and shows their Git state, dev servers, ports and coding agents in one window.",
    "homepage": "https://github.com/ezzdin-atef/devdock",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "DevDock",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNDNDRTA1MjZCM0NERUMKUldUc3piTW1CYzVEUHdsa3ZWb3lsRS9Ta0VDZHlCYjVScHBIOHEwMSsreUE5MFF0Y2t1SklWemUK",
      "endpoints": [
        "https://github.com/ezzdin-atef/devdock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
